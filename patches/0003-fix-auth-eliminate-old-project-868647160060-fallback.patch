From 7eb3185bd9b8e7ae61766a061a131b84160e8d51 Mon Sep 17 00:00:00 2001
From: Soham Kharat <sohamkharat481@gmail.com>
Date: Thu, 22 Oct 2026 18:16:54 +0000
Subject: [PATCH 3/4] fix(auth): eliminate old project 868647160060 fallbacks
 and add configuration mismatch detection

---
 src/server/serverAuthService.ts |  2 +-
 src/services/auth.ts            | 16 +++++++++++++---
 2 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/src/server/serverAuthService.ts b/src/server/serverAuthService.ts
index 26016fa..f76aa80 100644
--- a/src/server/serverAuthService.ts
+++ b/src/server/serverAuthService.ts
@@ -40,7 +40,7 @@ function getFirebaseConfig(): { projectId?: string; apiKey?: string } {
 
   cachedFirebaseConfig = {
     projectId: process.env.VITE_FIREBASE_PROJECT_ID || process.env.FIREBASE_PROJECT_ID || 'linkedin-tool-510912',
-    apiKey: process.env.VITE_FIREBASE_API_KEY || process.env.FIREBASE_API_KEY || 'AIzaSyAIOhDtP8yjvPTFdepJ9n9Wh0pbN3Os8rQ'
+    apiKey: process.env.VITE_FIREBASE_API_KEY || process.env.FIREBASE_API_KEY || ''
   };
   return cachedFirebaseConfig;
 }
diff --git a/src/services/auth.ts b/src/services/auth.ts
index 2efb960..de615f5 100644
--- a/src/services/auth.ts
+++ b/src/services/auth.ts
@@ -19,11 +19,11 @@ export const getResolvedFirebaseConfig = () => {
   const resolvedProjectId = baseConfig.projectId || env.VITE_FIREBASE_PROJECT_ID || 'linkedin-tool-510912';
   return {
     projectId: resolvedProjectId,
-    apiKey: baseConfig.apiKey || env.VITE_FIREBASE_API_KEY || 'AIzaSyAIOhDtP8yjvPTFdepJ9n9Wh0pbN3Os8rQ',
+    apiKey: baseConfig.apiKey || env.VITE_FIREBASE_API_KEY || '',
     authDomain: baseConfig.authDomain || env.VITE_FIREBASE_AUTH_DOMAIN || `${resolvedProjectId}.firebaseapp.com`,
     storageBucket: baseConfig.storageBucket || env.VITE_FIREBASE_STORAGE_BUCKET || `${resolvedProjectId}.firebasestorage.app`,
-    messagingSenderId: baseConfig.messagingSenderId || env.VITE_FIREBASE_MESSAGING_SENDER_ID || '868647160060',
-    appId: baseConfig.appId || env.VITE_FIREBASE_APP_ID || '1:868647160060:web:80a9e5c5a101bc7341ef79',
+    messagingSenderId: baseConfig.messagingSenderId || env.VITE_FIREBASE_MESSAGING_SENDER_ID || '',
+    appId: baseConfig.appId || env.VITE_FIREBASE_APP_ID || '',
     measurementId: baseConfig.measurementId || env.VITE_FIREBASE_MEASUREMENT_ID || ''
   };
 };
@@ -207,6 +207,16 @@ export const googleSignIn = async (): Promise<{
 } | null> => {
   try {
     isSigningIn = true;
+    const activeCfg = getResolvedFirebaseConfig();
+    if (
+      activeCfg.projectId === 'linkedin-tool-510912' &&
+      (activeCfg.appId.includes('868647160060') || activeCfg.apiKey === 'AIzaSyAIOhDtP8yjvPTFdepJ9n9Wh0pbN3Os8rQ')
+    ) {
+      console.warn(
+        '[Firebase Configuration Mismatch] Project ID is "linkedin-tool-510912", but API key or App ID belongs to project 868647160060 (project-8f9ec042-024f-49a1-9f1). This causes auth/unauthorized-domain until genuine Web App credentials for linkedin-tool-510912 are provided.'
+      );
+    }
+
     let result;
     try {
       result = await signInWithPopup(auth, provider);
-- 
