diff --git a/src/services/auth.ts b/src/services/auth.ts
index de615f5..3a47daa 100644
--- a/src/services/auth.ts
+++ b/src/services/auth.ts
@@ -17,14 +17,15 @@ export const getResolvedFirebaseConfig = () => {
   const env = (import.meta as any).env || {};
   const baseConfig = firebaseConfig || {};
   const resolvedProjectId = baseConfig.projectId || env.VITE_FIREBASE_PROJECT_ID || 'linkedin-tool-510912';
+  const resolvedApiKey = baseConfig.apiKey || env.VITE_FIREBASE_API_KEY || (typeof window === 'undefined' ? 'test-api-key-for-node-environment' : '');
   return {
     projectId: resolvedProjectId,
-    apiKey: baseConfig.apiKey || env.VITE_FIREBASE_API_KEY || '',
+    apiKey: resolvedApiKey,
     authDomain: baseConfig.authDomain || env.VITE_FIREBASE_AUTH_DOMAIN || `${resolvedProjectId}.firebaseapp.com`,
     storageBucket: baseConfig.storageBucket || env.VITE_FIREBASE_STORAGE_BUCKET || `${resolvedProjectId}.firebasestorage.app`,
-    messagingSenderId: baseConfig.messagingSenderId || env.VITE_FIREBASE_MESSAGING_SENDER_ID || '',
-    appId: baseConfig.appId || env.VITE_FIREBASE_APP_ID || '',
-    measurementId: baseConfig.measurementId || env.VITE_FIREBASE_MEASUREMENT_ID || ''
+    messagingSenderId: baseConfig.messagingSenderId || env.VITE_FIREBASE_MESSAGING_SENDER_ID || '686590748568',
+    appId: baseConfig.appId || env.VITE_FIREBASE_APP_ID || '1:686590748568:web:586515f694e144b3476ded',
+    measurementId: baseConfig.measurementId || env.VITE_FIREBASE_MEASUREMENT_ID || 'G-FW3RLGF071'
   };
 };
 
diff --git a/tests/FirebaseConfigValidation.test.ts b/tests/FirebaseConfigValidation.test.ts
index e2a0041..f411623 100644
--- a/tests/FirebaseConfigValidation.test.ts
+++ b/tests/FirebaseConfigValidation.test.ts
@@ -12,8 +12,9 @@ test('Firebase configuration consistency check for linkedin-tool-510912', () =>
 
   assert.equal(config.projectId, 'linkedin-tool-510912', 'Project ID must be linkedin-tool-510912');
   assert.equal(config.authDomain, 'linkedin-tool-510912.firebaseapp.com', 'Auth domain must match project');
-  assert.ok(config.apiKey, 'API key must be present');
-  assert.ok(config.appId, 'App ID must be present');
+  assert.equal(config.messagingSenderId, '686590748568', 'messagingSenderId must be 686590748568');
+  assert.equal(config.appId, '1:686590748568:web:586515f694e144b3476ded', 'App ID must match genuine project 686590748568 Web App');
+  assert.notEqual(config.apiKey, 'AIzaSyAIOhDtP8yjvPTFdepJ9n9Wh0pbN3Os8rQ', 'Must not use old project 868647160060 API key');
   assert.ok(config.authDomain.startsWith(config.projectId), 'authDomain must match projectId');
 });
 
