From d67ddf83b439d52a1db65a6ec4c70ef31b44196a Mon Sep 17 00:00:00 2001
From: Soham Kharat <sohamkharat481@gmail.com>
Date: Thu, 22 Oct 2026 18:13:24 +0000
Subject: [PATCH 2/3] fix(auth): dynamically resolve Firebase config and
 prevent stale instance mismatch

---
 src/server/serverAuthService.ts        | 19 +++++++++++++-
 src/services/auth.ts                   | 36 +++++++++++++++++++-------
 tests/FirebaseConfigValidation.test.ts | 10 +++++++
 3 files changed, 55 insertions(+), 10 deletions(-)

diff --git a/src/server/serverAuthService.ts b/src/server/serverAuthService.ts
index 1d85b2c..26016fa 100644
--- a/src/server/serverAuthService.ts
+++ b/src/server/serverAuthService.ts
@@ -21,8 +21,25 @@ let cachedFirebaseConfig: { projectId?: string; apiKey?: string } | null = null;
 function getFirebaseConfig(): { projectId?: string; apiKey?: string } {
   if (cachedFirebaseConfig) return cachedFirebaseConfig;
   
+  try {
+    const configPath = path.resolve(process.cwd(), 'firebase-applet-config.json');
+    if (fs.existsSync(configPath)) {
+      const content = fs.readFileSync(configPath, 'utf8');
+      const parsed = JSON.parse(content);
+      if (parsed?.projectId) {
+        cachedFirebaseConfig = {
+          projectId: parsed.projectId,
+          apiKey: parsed.apiKey || process.env.VITE_FIREBASE_API_KEY || process.env.FIREBASE_API_KEY || ''
+        };
+        return cachedFirebaseConfig;
+      }
+    }
+  } catch (e) {
+    console.warn('Could not read firebase-applet-config.json:', e);
+  }
+
   cachedFirebaseConfig = {
-    projectId: 'linkedin-tool-510912',
+    projectId: process.env.VITE_FIREBASE_PROJECT_ID || process.env.FIREBASE_PROJECT_ID || 'linkedin-tool-510912',
     apiKey: process.env.VITE_FIREBASE_API_KEY || process.env.FIREBASE_API_KEY || 'AIzaSyAIOhDtP8yjvPTFdepJ9n9Wh0pbN3Os8rQ'
   };
   return cachedFirebaseConfig;
diff --git a/src/services/auth.ts b/src/services/auth.ts
index f63cbf7..2efb960 100644
--- a/src/services/auth.ts
+++ b/src/services/auth.ts
@@ -13,22 +13,40 @@ import {
 } from 'firebase/auth';
 import firebaseConfig from '../../firebase-applet-config.json';
 
-const getResolvedFirebaseConfig = () => {
+export const getResolvedFirebaseConfig = () => {
+  const env = (import.meta as any).env || {};
   const baseConfig = firebaseConfig || {};
+  const resolvedProjectId = baseConfig.projectId || env.VITE_FIREBASE_PROJECT_ID || 'linkedin-tool-510912';
   return {
-    projectId: 'linkedin-tool-510912',
-    apiKey: baseConfig.apiKey || (import.meta as any).env?.VITE_FIREBASE_API_KEY || 'AIzaSyAIOhDtP8yjvPTFdepJ9n9Wh0pbN3Os8rQ',
-    authDomain: 'linkedin-tool-510912.firebaseapp.com',
-    storageBucket: 'linkedin-tool-510912.firebasestorage.app',
-    messagingSenderId: baseConfig.messagingSenderId || '868647160060',
-    appId: baseConfig.appId || '1:868647160060:web:80a9e5c5a101bc7341ef79',
-    measurementId: baseConfig.measurementId || ''
+    projectId: resolvedProjectId,
+    apiKey: baseConfig.apiKey || env.VITE_FIREBASE_API_KEY || 'AIzaSyAIOhDtP8yjvPTFdepJ9n9Wh0pbN3Os8rQ',
+    authDomain: baseConfig.authDomain || env.VITE_FIREBASE_AUTH_DOMAIN || `${resolvedProjectId}.firebaseapp.com`,
+    storageBucket: baseConfig.storageBucket || env.VITE_FIREBASE_STORAGE_BUCKET || `${resolvedProjectId}.firebasestorage.app`,
+    messagingSenderId: baseConfig.messagingSenderId || env.VITE_FIREBASE_MESSAGING_SENDER_ID || '868647160060',
+    appId: baseConfig.appId || env.VITE_FIREBASE_APP_ID || '1:868647160060:web:80a9e5c5a101bc7341ef79',
+    measurementId: baseConfig.measurementId || env.VITE_FIREBASE_MEASUREMENT_ID || ''
   };
 };
 
 // Initialize Firebase App
 const resolvedConfig = getResolvedFirebaseConfig();
-const app = getApps().length > 0 ? getApp() : initializeApp(resolvedConfig);
+let appInstance;
+const existingApps = getApps();
+if (existingApps.length > 0) {
+  const defaultApp = getApp();
+  if (
+    defaultApp.options.projectId !== resolvedConfig.projectId ||
+    defaultApp.options.apiKey !== resolvedConfig.apiKey
+  ) {
+    console.warn('Re-initializing Firebase App instance due to project configuration mismatch.');
+    appInstance = initializeApp(resolvedConfig, `app-${Date.now()}`);
+  } else {
+    appInstance = defaultApp;
+  }
+} else {
+  appInstance = initializeApp(resolvedConfig);
+}
+export const app = appInstance;
 export const auth = getAuth(app);
 setPersistence(auth, browserLocalPersistence).catch((err) => {
   console.warn('Failed to set auth persistence:', err);
diff --git a/tests/FirebaseConfigValidation.test.ts b/tests/FirebaseConfigValidation.test.ts
index cd494aa..e2a0041 100644
--- a/tests/FirebaseConfigValidation.test.ts
+++ b/tests/FirebaseConfigValidation.test.ts
@@ -14,4 +14,14 @@ test('Firebase configuration consistency check for linkedin-tool-510912', () =>
   assert.equal(config.authDomain, 'linkedin-tool-510912.firebaseapp.com', 'Auth domain must match project');
   assert.ok(config.apiKey, 'API key must be present');
   assert.ok(config.appId, 'App ID must be present');
+  assert.ok(config.authDomain.startsWith(config.projectId), 'authDomain must match projectId');
+});
+
+test('Firebase authDomain conforms to canonical Firebase format without path or protocol', () => {
+  const configPath = path.resolve(process.cwd(), 'firebase-applet-config.json');
+  const config = JSON.parse(fs.readFileSync(configPath, 'utf8'));
+
+  assert.equal(config.authDomain.includes('https://'), false, 'authDomain should not include protocol');
+  assert.equal(config.authDomain.includes('/'), false, 'authDomain should not include path or trailing slash');
+  assert.match(config.authDomain, /^[a-z0-9\-]+\.firebaseapp\.com$/, 'authDomain must be a valid firebaseapp.com domain');
 });
