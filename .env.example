# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION (Server & Client runtime environment variables)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# GOOGLE MAPS PLACES API (Primary Lead Provider - Server-side secret only)
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# SERPER.DEV GOOGLE SEARCH API (Optional fallback - Server-side secret only)
SERPER_API_KEY="your-serper-api-key"

# LEADOCEAN B2B PEOPLE SEARCH API (Optional fallback - Server-side secret only)
LEADOCEAN_API_KEY="your-leadocean-api-key"
