# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION (Server & Client runtime environment variables)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# SERPER.DEV GOOGLE SEARCH API (Server-side secret only)
SERPER_API_KEY="your-serper-api-key"

# LEADOCEAN B2B PEOPLE SEARCH API (Server-side secret only)
LEADOCEAN_API_KEY="your-leadocean-api-key"

# INSTAGRAM BUSINESS DISCOVERY (Server-side only; never use a VITE_ prefix)
INSTAGRAM_ACCESS_TOKEN="your-meta-user-access-token"
INSTAGRAM_USER_ID="your-instagram-professional-account-id"
# Optional; defaults to v25.0
INSTAGRAM_GRAPH_API_VERSION="v25.0"
